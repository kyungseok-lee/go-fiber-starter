# === 앱 ===
APP_NAME=go-fiber-starter
# local | dev | prod (prod + sqlite 조합은 시작 시 거부됨)
APP_ENV=local
APP_PORT=8080
# debug | info | warn | error (일반 SQL은 debug, 오류·느린 SQL은 error/warn)
LOG_LEVEL=info

# === 데이터베이스 ===
# postgres | mysql | sqlite
DB_DRIVER=sqlite
# sqlite: 파일 경로 / postgres: postgres://user:pass@localhost:5432/db?sslmode=disable
# mysql:  user:pass@tcp(localhost:3306)/db?parseTime=true
DB_DSN=data/app.db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
# local/dev 편의용 AutoMigrate. APP_ENV=prod의 postgres/mysql에서는 true 금지 — ./cmd/migrate 사용
DB_AUTO_MIGRATE=true
DB_SLOW_QUERY_THRESHOLD=500ms

# === HTTP/미들웨어 ===
# 허용 오리진(콤마 구분). prod에서 "*"는 시작 시 거부됨 (local/dev에서만 허용)
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# === 역프록시 (nginx/ALB 등 뒤에서 실행할 때만) ===
# true면 신뢰 프록시의 X-Forwarded-For를 받아 c.IP()가 실제 클라이언트 IP를 반환.
# 헤더 위조 방지를 위해 allowlist(TRUST_PROXY_PROXIES) 설정이 필수이며, false인데 목록을 두면 시작 거부됨
TRUST_PROXY=false
# 신뢰할 프록시 IP/CIDR 목록 (콤마 구분). 예: 10.0.0.5,172.17.0.0/16
TRUST_PROXY_PROXIES=
# 클라이언트 IP를 읽을 헤더
TRUST_PROXY_HEADER=X-Forwarded-For

# === 종료 대기 ===
SHUTDOWN_GRACE_PERIOD=10s

# === 인증 (JWT 스캐폴드) ===
# true면 /api/v1/auth/login 활성화 + /api/v1/tasks 전체에 Bearer 토큰 요구
AUTH_ENABLED=false
# 로그인 분당 시도 한도(IP별). 전역 값(RATE_LIMIT_PER_MINUTE) 이하로 설정
AUTH_RATE_LIMIT_PER_MINUTE=10
# HS256 서명 키. AUTH_ENABLED=true면 32바이트 이상 필수 (예: openssl rand -base64 48)
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=1h
# 개발용 자격증명(demo authenticator). local/dev 전용 — prod에서 기본값(admin/admin123)은 시작 시 거부됨.
# DB 기반 Authenticator로 교체할 때는 router 조립과 config의 데모 전용 검증도 함께 수정 (README "인증" 참고)
AUTH_DEMO_USERNAME=admin
AUTH_DEMO_PASSWORD=admin123
